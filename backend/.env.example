# ============================================================
# SERVER
# ============================================================
PORT=4000
NODE_ENV=development
# Comma-separated allowed browser origins (all origins are allowed when empty; set this in production)
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app; used as the domain/URI in wallet-link messages
PUBLIC_APP_URL=http://localhost:3000
# Random 32+ byte hex string; signs wallet-link challenges and GitHub install state
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SIGNING_SECRET=

# ============================================================
# DATABASE (Supabase Postgres)
# ============================================================
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# ============================================================
# SUPABASE AUTH
# ============================================================
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<supabase-anon-key>"

# ============================================================
# GITHUB APP (securexMST)
# ============================================================
GITHUB_APP_ID=5112750
GITHUB_APP_NAME=securexMST
# Path to the App's PEM private key (relative to backend/ or absolute). Never commit the key.
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/<app-private-key>.pem
# On hosts without a filesystem (Render), set the PEM itself instead (real newlines or literal \n):
# GITHUB_APP_PRIVATE_KEY=
# GitHub App client ID (GitHub App settings -> General). Enables "Connect GitHub" for participants via the
# OAuth device flow; also tick "Enable Device Flow" in the App settings. No client secret is needed.
GITHUB_APP_CLIENT_ID=
# Participants must connect GitHub before starting challenges (set false to disable)
GITHUB_CONNECTION_REQUIRED=true
# Set when the GitHub webhook is configured (same value as in the GitHub App settings)
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

# ============================================================
# MST BLOCKCHAIN (leave empty until the reward contract is finalized)
# ============================================================
# After `cd ../blockchain && npm run deploy:mst`, run `npm run chain:configure` here to fill these in.
MST_NETWORK=mst-testnet
MST_RPC_URL=
MST_CHAIN_ID=
MST_EXPLORER_URL=
MST_CHALLENGE_REGISTRY_ADDRESS=
MST_SUBMISSION_REGISTRY_ADDRESS=
# RewardVault address
MST_REWARD_CONTRACT_ADDRESS=
# SERVER-ONLY key holding VERIFIER_ROLE + REWARD_DISTRIBUTOR_ROLE (never expose to the frontend)
MST_VERIFIER_PRIVATE_KEY=
# Wei paid per MST reward unit (rewards.amount). Default 0.001 tMSTC; the vault also caps each reward.
# Wei paid per whole MSTC of challenge reward: 1e18 = 1 MSTC (18 decimals). The vault cap/balance must cover it.
MST_REWARD_WEI_PER_UNIT=1000000000000000000
# Minimum organization funding before publishing (0 = rewards come from the platform vault)
MST_ORG_MIN_FUNDING=0
MST_TOKEN_CONTRACT_ADDRESS=
MST_REWARD_CONTRACT_ABI=

# ============================================================
# SEED (npm run seed) - optional overrides
# ============================================================
# With Supabase email confirmation ON, use real mailboxes you can open:
# SEED_ADMIN_EMAIL=
# SEED_PARTICIPANT_EMAIL=
# SEED_ORG_EMAIL=
# SEED_ORG_NAME=SECUREX Demo Security
# GITHUB_INSTALLATION_ID=   # link + sync this GitHub App installation for the seeded organization

# ============================================================
# BRIDGEKEY
# ============================================================
# No BridgeKey secret belongs here. Wallet connection happens in the frontend;
# the backend only verifies signed wallet-link messages (see README).
