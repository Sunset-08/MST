# ============================================================
# SERVER
# ============================================================
PORT=4000
NODE_ENV=development
# Comma-separated allowed browser origins (all origins are allowed when empty; set this in production)
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app; used as the domain/URI in wallet-link messages
PUBLIC_APP_URL=http://localhost:3000
# Random 32+ byte hex string; signs wallet-link challenges and GitHub install state
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SIGNING_SECRET=

# ============================================================
# DATABASE (Supabase Postgres)
# ============================================================
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# ============================================================
# SUPABASE AUTH
# ============================================================
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<supabase-anon-key>"

# ============================================================
# GITHUB APP (securexMST)
# ============================================================
GITHUB_APP_ID=5112750
GITHUB_APP_NAME=securexMST
# Path to the App's PEM private key (relative to backend/ or absolute). Never commit the key.
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/<app-private-key>.pem
# Set when the GitHub webhook is configured (same value as in the GitHub App settings)
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

# ============================================================
# MST BLOCKCHAIN (leave empty until the reward contract is finalized)
# ============================================================
MST_NETWORK=mst-testnet
MST_RPC_URL=
MST_CHAIN_ID=
MST_TOKEN_CONTRACT_ADDRESS=
MST_REWARD_CONTRACT_ADDRESS=
MST_REWARD_CONTRACT_ABI=
MST_EXPLORER_URL=

# ============================================================
# BRIDGEKEY
# ============================================================
# No BridgeKey secret belongs here. Wallet connection happens in the frontend;
# the backend only verifies signed wallet-link messages (see README).
