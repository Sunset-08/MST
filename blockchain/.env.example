# SERVER / DEPLOY ONLY. Never expose these to frontend code or commit .env.
DEPLOYER_PRIVATE_KEY=
# Optional: separate verifier/reward key (defaults to DEPLOYER_PRIVATE_KEY)
VERIFIER_PRIVATE_KEY=
# Optional: address granted VERIFIER_ROLE + REWARD_DISTRIBUTOR_ROLE at deploy (defaults to deployer)
VERIFIER_ADDRESS=
# Optional: player wallet used by the e2e flow script (a fresh one is generated and gas-funded if empty)
PLAYER_PRIVATE_KEY=
# Optional overrides
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
VAULT_FUNDING_TMSTC=0.2
MAX_REWARD_TMSTC=0.05
